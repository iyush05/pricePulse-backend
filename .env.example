# Application
APP_NAME=PricePulse
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-very-secret-key-in-production-1234567890abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + TimescaleDB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pricepulse
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pricepulse
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pricepulse

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Search (Meilisearch)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey123456

# Third Party Notifications & Services
SENDGRID_API_KEY=
EMAIL_FROM=alerts@pricepulse.local
FCM_SERVER_KEY=
WEBHOOK_TIMEOUT_SECONDS=10

# AI / Chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scraping settings
PLAYWRIGHT_HEADLESS=True
DEFAULT_POLL_INTERVAL_S=21600
MIN_POLL_INTERVAL_S=3600
MAX_POLL_INTERVAL_S=172800
